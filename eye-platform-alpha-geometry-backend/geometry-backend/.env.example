# Copy to .env and fill in real values. Never commit .env with real secrets.

# Reconstruction provider: procedural | dpt-depth-mesh | triposr | replicate
EYE_RECONSTRUCTION_PROVIDER=replicate
PUBLIC_BASE_URL=https://your-geometry-api.example.com

# Required only when EYE_RECONSTRUCTION_PROVIDER=replicate.
# Get a token at https://replicate.com/account/api-tokens (requires a Replicate account).
REPLICATE_API_TOKEN=

# Required only when EYE_RECONSTRUCTION_PROVIDER=replicate.
# Pick a maintained image-to-3D model version id from https://replicate.com/explore
# (e.g. a Hunyuan3D-2, TRELLIS, or Stable Fast 3D model).
EYE_REPLICATE_MODEL_VERSION=

# Allow falling back to procedural (non-AI) geometry if the selected AI provider fails.
EYE_ALLOW_PROCEDURAL_FALLBACK=0
